# ==============================================================================
# AirTAP Framework — Production-Grade .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Byte-compiled / Optimized / Binary Files
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.dll
*.dylib
*.exe
*.manifest
*.spec
*.bin
*.out
*.app
docs/superpowers/*
# ------------------------------------------------------------------------------
# 2. Distribution, Packaging & Build Artifacts
# ------------------------------------------------------------------------------
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt
pip-wheel-metadata/

# ------------------------------------------------------------------------------
# 3. Unit Test, Coverage, Linter & Type Check Caches
# ------------------------------------------------------------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
.benchmarks/

# ------------------------------------------------------------------------------
# 4. Secrets, Credentials & Local Environment Files
# ------------------------------------------------------------------------------
.env
.env.*
.envrc
*.pem
*.key
*.pkcs12
*.pfx
*.p12
id_rsa
id_ed25519
id_ecdsa
id_dsa
secrets.json
credentials.json
auth.json
tokens.json

# ------------------------------------------------------------------------------
# 5. Virtual Environments
# ------------------------------------------------------------------------------
.venv
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
venv-*/
env-*/

# ------------------------------------------------------------------------------
# 6. IDEs, Editors & OS Metadata
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.sw[a-p]
*~
*.bak
*.orig
*.rej
.~lock.*
.directory
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
*.sublime-project
*.sublime-workspace
.history/
.project
.pydevproject
.settings/

# ------------------------------------------------------------------------------
# 7. AI Agents, Assistants, Scratch & Session Memory
# ------------------------------------------------------------------------------
.worktrees/
.superpowers/
.remember/
.claude/
.agents/
.gemini/
.cursor/
.windsurf/
.aider*
.chat/
.continue/
scratch/
tmp/
*.tmp

# ------------------------------------------------------------------------------
# 8. Web GUI, Node & Frontend Build Caches (if applicable)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.parcel-cache/
.eslintcache/

# ------------------------------------------------------------------------------
# 9. Cellular captures, Radio Logs & Forensic Runtime Dumps
# ------------------------------------------------------------------------------
# Capture & Diagnostic stream formats
*.pcap
*.pcapng
*.cap
*.dmp
*.dlf
*.qmdl
*.qmdl2
*.json_geo
*.sdm
*.elt
*.isf
*.blf
*.btsnoop
*.snoop
*.trl
*.trace
*.hexdump
*.log

# Forensic dump outputs, fuzzing artifacts & live exports
audit_log*.json
sec_audit_*.json
fuzz_*.pcap
fuzz_*.json
fuzz.pcap
benchmark_*.json
wardrive_*.json
wardrive_*.kml
wardrive_*.gpx
efs_backup/
mem_dump/
nv_backup/

# ------------------------------------------------------------------------------
# 10. Whitelist / Explicitly Preserved Files & Directories
# ------------------------------------------------------------------------------
# Keep example env configuration
!.env.example

# Keep bundled cross-platform ADB executables & libraries
!src/inputs/external/adb/**

# Keep documentation samples and UI screenshots
!docs/sample_pcaps/*
!docs/screenshots/*

# Keep test fixtures and GUI static assets
!tests/fixtures/*
!src/modules/gui_assets/*
CLAUDE.md
