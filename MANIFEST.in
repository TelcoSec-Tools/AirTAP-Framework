# Files to include in a source distribution. Wheels get their data through
# package_data in setup.py; sdists need it spelled out here as well.

include LICENSE
include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include pyproject.toml
include setup.py
include requirements.txt
include requirements-dev.txt
include run.sh
include airtap.py

# Python source tree
recursive-include src *.py

# Wireshark Lua dissectors
recursive-include src/modules/wireshark_plugin *.lua

# AirTap Visual GUI Web Suite Assets
recursive-include src/modules/gui_assets *

# Bundled adb binaries and the on-device / WSL2 bridges
recursive-include src/inputs/external *
recursive-include src/inputs/adb_bridge *
recursive-include src/inputs/adb_wsl2_bridge *

# Documentation and tools
recursive-include docs *
recursive-include tools *

# Test suite
recursive-include tests *.py

recursive-exclude * __pycache__
recursive-exclude * *.py[co]
